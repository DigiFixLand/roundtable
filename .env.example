# ──────────────────────────────────────────────
# RoundTable — Environment Configuration
# ──────────────────────────────────────────────

# Individual API keys referenced by providers
# OpenRouter is the primary RoundTable route; OpenAI direct remains a fallback/validation path.
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENAI_API_KEY=sk-your-key-here
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Server-side history database (kept out of git)
ROUNDTABLE_DB_PATH=./data/roundtable.sqlite

# Model listing behavior:
#   STRICT_MODELS=true  → Only show the exact models listed below
#   STRICT_MODELS=false → Fetch all chat models from each provider API;
#                          listed models appear first as "preferred" (default)
STRICT_MODELS=false

# Provider configuration (JSON array)
# Each provider: id, name, baseUrl, apiKey, models (optional — preferred models)
# If models is omitted or empty, all chat models from the API are listed.
AI_PROVIDERS='[{"id":"openrouter","name":"OpenRouter","baseUrl":"https://openrouter.ai/api/v1","apiKey":"env:OPENROUTER_API_KEY","models":["google/gemini-2.5-flash-lite","openai/gpt-4.1-mini"]},{"id":"openai","name":"OpenAI","baseUrl":"https://api.openai.com/v1","apiKey":"env:OPENAI_API_KEY","models":["gpt-4.1-mini"]},{"id":"anthropic","name":"Anthropic","baseUrl":"https://api.anthropic.com/v1","apiKey":"env:ANTHROPIC_API_KEY","models":[]}]'
